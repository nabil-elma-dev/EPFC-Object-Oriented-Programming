@startuml
'https://plantuml.com/class-diagram

interface Scalable {
-- Abstract methods --
    {abstract} + translate(double, double) : void
}

interface Translatable {
-- Abstract methods --
   {abstract} + scale(double) : void
}

interface TranScalable implements Scalable, Translatable {
}

class Point {
-- Attributes --
    - px : double
    - py : double

-- Accessors --
    + getPx() : double
    + getPy() : double
    + setPx() : void
    + setPy() : void

-- ToString --
    + toString : void
}

class Rectangle implements TranScalable{
-- Attributes --
    - p : Point <<final>>
    - length : double
    - height : double

-- implemented methods --
    + scale(double) : void
    + translate(double, double) : void

-- ToString --
    + toString : void
}

class Circle implements TranScalable{
-- Attributes --
    - p : Point <<final>>
    - radius : double

-- implemented methods --
    + scale(double) : void
    + translate(double, double) : void

-- ToString --
    + toString : void
}





@enduml