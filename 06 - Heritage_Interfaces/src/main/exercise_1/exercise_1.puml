@startuml
'https://plantuml.com/class-diagram
left to right direction

interface Positionable {
-- Abstract methods --
    {abstract} + getPx() : double
    {abstract} + getPy() : double
    {abstract} + setPx() : void
    {abstract} + setPy() : void
}

interface Scalable {
-- Abstract methods --
    {abstract} + scale(double) : void
}

interface Translatable extends Positionable {
-- Abstract methods --
   {default} + translate(double, double) : void
}

interface TranScalable implements Scalable, Translatable {
}

class Point implements Translatable {
-- Attributes --
    - px : double
    - py : double

-- Accessors (implemented)--
    + getPx() : double
    + getPy() : double
    + setPx() : void
    + setPy() : void

-- ToString --
    + toString : void
}

abstract class Shape implements TranScalable {
-- Attributes --
    - p : Point <<final>>
-- Accessors (implemented)--
    + getPx() : double
    + getPy() : double
    + setPx() : void
    + setPy() : void

-- Implemented methods --
    + translate(double, double) : void

}

class Rectangle extends Shape{
-- Attributes --
    - length : double
    - height : double

-- Implemented methods --
    + scale(double) : void

-- ToString --
    + toString : void
}

class Circle extends Shape {
-- Attributes --
    - radius : double

-- Implemented methods --
    + scale(double) : void

-- ToString --
    + toString : void
}





@enduml