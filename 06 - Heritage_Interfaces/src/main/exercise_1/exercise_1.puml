@startuml
'https://plantuml.com/class-diagram

interface Scalable {
-- Abstract methods --
    {abstract} + translate(double, double) : void
}

interface Translatable {
-- Abstract methods --
   {abstract} + scale(double) : void
}

interface TranScalable implements Scalable, Translatable {
}

class Point {
-- Attributes --
    - px : double
    - py : double

-- Accessors --
    + getPx() : double
    + getPy() : double
    + setPx() : void
    + setPy() : void

-- ToString --
    + toString : void
}

abstract class Shape implements TranScalable {
-- Attributes --
    - p : Point <<final>>

-- Implemented methods --
    + translate(double, double) : void

}

class Rectangle extends Shape{
-- Attributes --
    - length : double
    - height : double

-- Implemented methods --
    + scale(double) : void

-- ToString --
    + toString : void
}

class Circle extends Shape {
-- Attributes --
    - radius : double

-- Implemented methods --
    + scale(double) : void

-- ToString --
    + toString : void
}





@enduml